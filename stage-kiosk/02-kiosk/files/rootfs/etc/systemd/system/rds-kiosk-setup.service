[Unit]
Description=RDS Pi Kiosk: local setup page
After=network.target rds-kiosk-config.service

[Service]
Type=simple
User=kiosk-setup
Group=kiosk-setup
ExecCondition=/usr/lib/rds-pi-kiosk/mode-is free
ExecStart=/usr/bin/python3 -I /usr/lib/rds-pi-kiosk/setupd.py
Restart=always
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/rds-pi-kiosk/requests
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=96M

[Install]
WantedBy=multi-user.target
