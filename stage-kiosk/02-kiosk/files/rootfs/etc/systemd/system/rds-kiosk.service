[Unit]
Description=RDS Pi Kiosk: fullscreen browser (free mode)
After=systemd-user-sessions.service rds-kiosk-config.service rds-kiosk-setup.service plymouth-quit-wait.service
After=dbus.socket systemd-logind.service
Wants=rds-kiosk-setup.service dbus.socket systemd-logind.service
ConditionPathExists=/dev/tty0
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=kiosk
PAMName=rds-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# Only one kiosk drives the screen: this one in free mode, rds-agent in RDS mode.
ExecCondition=/usr/lib/rds-pi-kiosk/mode-is free
ExecStart=/usr/bin/cage -d -- /usr/lib/rds-pi-kiosk/session
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
